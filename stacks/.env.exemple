# ==============================================================================
# OpenMediaVault HomeLab - Global Environment Configuration (.env.exemple)
# Location: @directory:stacks/.env.exemple
# Copy this file to .env and adjust variables for your environment.
# ==============================================================================

# --- SYSTEM & HARDWARE ---
TZ=Europe/Paris
PHYSICAL_INTERFACE=enp4s0
USB_THREAD=/dev/serial/by-path/pci-0000:00:1a.0-usb-0:1.1:1.0-port0
USB_ZIGBEE=/dev/serial/by-path/pci-0000:00:1a.0-usb-0:1.2:1.0-port0

# --- NETWORK & SYSTEM IP ADDRESSES ---
HOST_IP=192.168.1.64
PIHOLE_IP=192.168.1.53
GATEWAY_IP=192.168.1.254
SUBNET=192.168.1.0/24

# --- DOMAINS ---
DOMAIN_TRAEFIK=traefik.lan
DOMAIN_AUTH=auth.lan
DOMAIN_DASH=home.lan
DOMAIN_PHOTOS=photos.lan

# --- STORAGE DISKS & MOUNT POINTS (EXT4) ---
PHOTOS_DISK_UUID=52E654B8E6549E53
BACKUP_DISK_UUID=7AF2DC71F2DC335D
PHOTOS_MOUNT_POINT=/srv/dev-disk-by-uuid-52E654B8E6549E53
BACKUP_MOUNT_POINT=/srv/dev-disk-by-uuid-7AF2DC71F2DC335D
USER_FAMILY_GROUP=Famille

# --- AUTHENTIK SSO CREDENTIALS ---
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=authentik_db_password_change_me
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_SECRET_KEY=authentik_secret_key_change_me_super_secret

# --- IMMICH MEDIA CREDENTIALS ---
IMMICH_DB_USER=postgres
IMMICH_DB_PASSWORD=immich_db_password_change_me
IMMICH_DB_NAME=immich
IMMICH_URL=http://127.0.0.1:2283
IMMICH_API_KEY=your_immich_api_key_here

# --- PI-HOLE CREDENTIALS ---
PIHOLE_PASSWORD=admin

# --- HOME ASSISTANT CREDENTIALS ---
HA_USER=charles.coude
HA_API_KEY=your_ha_api_key_here
