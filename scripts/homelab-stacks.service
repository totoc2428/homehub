[Unit]
Description=HomeLab Docker Stacks Plug & Play Boot Service
Documentation=https://github.com/openmediavault
Requires=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/openmedia/stacks
ExecStart=/bin/bash /opt/openmedia/scripts/homelab_startup.sh
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
