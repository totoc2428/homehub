# ==============================================================================
# Git Ignore Configuration - OpenMediaVault HomeLab Architecture
# ==============================================================================

# Ignore sensitive environment files containing credentials/tokens
.env
*.env
**/.env
.env.local
.env.*.local

# Allow tracked template / example environment files
!.env.exemple
!.env.example
!*.env.exemple
!*.env.example

# Ignore legacy/archived folder
archive/

# Ignore Python bytecode & cache
__pycache__/
*.pyc
*.pyo

# Ignore runtime log files
*.log
